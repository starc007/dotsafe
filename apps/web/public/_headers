# Read by Cloudflare's static assets.
# Markdown copies of the pages, llms.txt and the feed, for agents (see
# scripts/agent-files.ts). Plain text so browsers show it instead of
# downloading it, and UTF-8 for the ⌘ and → in the pages.
/docs.md
  Content-Type: text/plain; charset=utf-8
/docs/*.md
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/index.md
  Content-Type: text/plain; charset=utf-8
/pricing.md
  Content-Type: text/plain; charset=utf-8
/download.md
  Content-Type: text/plain; charset=utf-8
/changelog.md
  Content-Type: text/plain; charset=utf-8
/privacy.md
  Content-Type: text/plain; charset=utf-8
/terms.md
  Content-Type: text/plain; charset=utf-8
/alternatives.md
  Content-Type: text/plain; charset=utf-8
/alternatives/*.md
  Content-Type: text/plain; charset=utf-8
/for.md
  Content-Type: text/plain; charset=utf-8
/for/*.md
  Content-Type: text/plain; charset=utf-8
/rotate.md
  Content-Type: text/plain; charset=utf-8
/rotate/*.md
  Content-Type: text/plain; charset=utf-8
/blog.md
  Content-Type: text/plain; charset=utf-8
/blog/*.md
  Content-Type: text/plain; charset=utf-8
/blog.xml
  Content-Type: application/rss+xml; charset=utf-8
/changelog.xml
  Content-Type: application/rss+xml; charset=utf-8

