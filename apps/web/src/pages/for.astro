import ContentHub from '@/components/ContentHub.astro';
import { USE_CASES } from '@/lib/content-pages';

const { href, title, description } = USE_CASES;
---

<Layout meta={{ title, description, path: href, markdown: `${href}.md` }}>
  <ContentHub section={USE_CASES} />
</Layout>
