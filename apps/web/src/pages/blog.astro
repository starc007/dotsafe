---
import Layout from '@/layouts/Layout.astro';
import FinalCta from '@/components/landing/FinalCta.astro';
import { BLOG, POSTS } from '@/lib/blog';
import { docsContent } from '@/lib/docs-content';
import { formatUpdated } from '@/lib/updated';

/** Every post, newest first: date, title and description, each a link. */
const posts = POSTS.map((post) => ({ ...post, href: `${BLOG.href}/${post.slug}`, ...docsContent(`${BLOG.href}/${post.slug}`) }));
---

<Layout meta={{ title: BLOG.title, description: BLOG.description, path: BLOG.href, markdown: `${BLOG.href}.md`, blogFeed: true }}>
  <section class="mx-auto w-full max-w-2xl px-4 pt-32 pb-24 sm:px-6 sm:pt-40">
    <h1 class="text-[30px] leading-[1.15] font-medium tracking-[-0.025em] sm:text-[36px]">{BLOG.title}</h1>
    <p class="mt-3 text-base leading-relaxed text-pretty text-ds-muted">{BLOG.description}</p>
    <ol class="mt-12 flex flex-col">
      {
        posts.map((post) => (
          <li class="border-t border-ds-line first:border-t-0">
            <a href={post.href} class="group block py-6 focus-visible:outline-none">
              <time datetime={post.published} class="text-sm text-ds-muted">
                {formatUpdated(post.published)}
              </time>
              <h2 class="mt-1.5 text-lg font-medium tracking-[-0.01em] text-balance group-hover:underline group-focus-visible:underline">
                {post.title}
              </h2>
              <p class="mt-1.5 text-sm leading-relaxed text-pretty text-ds-muted">{post.description}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
  <FinalCta />
</Layout>
