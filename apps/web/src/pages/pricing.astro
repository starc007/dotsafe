---
import Layout from '@/layouts/Layout.astro';
import Faq from '@/components/landing/Faq.astro';
import FinalCta from '@/components/landing/FinalCta.astro';
import { JsonLd } from '@/components/landing/JsonLd';
import PricingPlans from '@/components/landing/PricingPlans.astro';
import { faqData } from '@/lib/structured-data';

const meta = {
  title: 'Pricing',
  description: 'One dotsafe license, $49 once, for up to 2 computers, Mac or Linux. Every feature included, with lifetime updates.',
  path: '/pricing',
  markdown: '/pricing.md',
};
---

<Layout meta={meta}>
  <JsonLd data={faqData} />
  <section class="mx-auto max-w-6xl px-4 pt-32 sm:px-6 sm:pt-40">
    <h1 class="max-w-2xl text-[28px] leading-[1.2] font-medium tracking-[-0.02em] text-balance sm:text-[36px]">
      Pay once, keep it. <span class="text-ds-muted">One license for everything.</span>
    </h1>
    <div class="mt-12">
      <PricingPlans />
    </div>
  </section>
  <Faq />
  <FinalCta />
</Layout>
