---
import Layout from '@/layouts/Layout.astro';
import MarkdownPage from '@/components/MarkdownPage.astro';
import { ROTATION, sectionPaths } from '@/lib/content-pages';
import { docsContent } from '@/lib/docs-content';

/** One static page per slug in lib/content-pages.ts; anything else is a 404. */
export function getStaticPaths() {
  return sectionPaths(ROTATION).map((path) => ({ params: { slug: path.slice(`${ROTATION.href}/`.length) } }));
}

const href = `${ROTATION.href}/${Astro.params.slug}`;
const { title, description } = docsContent(href);
---

<Layout meta={{ title, description, path: href, markdown: `${href}.md` }}>
  <MarkdownPage href={href} eyebrow="Key rotation" section={{ name: 'Key rotation', href: ROTATION.href }} cta />
</Layout>
