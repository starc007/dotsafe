---
import Layout from '@/layouts/Layout.astro';
import Reveal from '@/components/landing/Reveal.astro';
import Wallpaper from '@/components/landing/Wallpaper.astro';
import { RELEASES } from '@/lib/changelog';

const meta = {
  title: 'Changelog',
  description: 'New features, fixes and improvements in each dotsafe release.',
  path: '/changelog',
  markdown: '/changelog.md',
  feed: true,
};

const dateFormat = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

/** Releases as a timeline held together by space, not lines: the date and
 * version stay pinned on the left while the release scrolls past. */
---

<Layout meta={meta}>
  <section class="mx-auto max-w-6xl px-4 pt-32 pb-28 sm:px-6 sm:pt-40">
    <h1 class="max-w-2xl text-[28px] leading-[1.2] font-medium tracking-[-0.02em] text-balance sm:text-[36px]">
      Changelog <span class="text-ds-muted">New features, fixes and improvements in each release.</span>
    </h1>
    <ol class="mt-16 flex flex-col gap-24 sm:mt-24 sm:gap-32">
      {
        RELEASES.map((release) => (
          <li id={`v${release.version}`} class="grid scroll-mt-28 gap-5 md:grid-cols-4 md:gap-10">
            <div class="flex items-baseline gap-3 self-start md:sticky md:top-28 md:flex-col md:gap-1">
              <p class="text-sm font-medium">
                {release.date ? <time datetime={release.date}>{dateFormat.format(new Date(release.date))}</time> : 'Upcoming'}
              </p>
              <p class="font-mono text-xs text-ds-muted tabular-nums">v{release.version}</p>
            </div>
            <Reveal class="md:col-span-3">
              <h2 class="text-2xl leading-tight font-medium tracking-[-0.015em] text-balance sm:text-[28px]">{release.title}</h2>
              {release.summary && <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-pretty text-ds-muted">{release.summary}</p>}
              {release.image && (
                <Wallpaper scene={release.scene ?? 'meadow'} class="mt-8 px-4 pt-8 sm:px-10 sm:pt-12">
                  <div class="rounded-t-xl bg-white/40 p-1.5 pb-0 backdrop-blur-md">
                    <img
                      src={release.image.src}
                      alt={release.image.alt}
                      width={release.image.width}
                      height={release.image.height}
                      loading="lazy"
                      class="h-auto w-full rounded-t-lg"
                    />
                  </div>
                </Wallpaper>
              )}
              <ul class="mt-8 grid max-w-2xl gap-x-10 gap-y-4 text-sm leading-relaxed sm:grid-cols-2">
                {release.changes.map((change) => (
                  <li class="flex gap-3 text-pretty">
                    <span aria-hidden="true" class="mt-[8px] size-1.5 shrink-0 rounded-full bg-ds-primary" />
                    {change}
                  </li>
                ))}
              </ul>
            </Reveal>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
