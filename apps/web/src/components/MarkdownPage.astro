---
import { docsContent } from '@/lib/docs-content';
import { contentPageData } from '@/lib/structured-data';
import Markdown from '@/components/docs/Markdown.astro';
import FinalCta from '@/components/landing/FinalCta.astro';
import { JsonLd } from '@/components/landing/JsonLd';
import Updated from '@/components/Updated.astro';
import { pageUpdated } from '@/lib/updated';

/** A page written in Markdown at `public/<href>.md`, like the docs: the legal
 * pages, the alternatives and the use-case pages. The same file is served as
 * is at `<href>.md` for agents. `section` is the hub it belongs to, shown as
 * the eyebrow and in the breadcrumb; `cta` ends the page with the landing
 * page's closing call to action. */
interface Props {
  href: string;
  eyebrow: string;
  section?: { name: string; href: string };
  cta?: boolean;
}

const { href, eyebrow, section, cta } = Astro.props;
const page = docsContent(href);
// The legal pages carry their own "Last updated" line.
const updated = section && pageUpdated(href);
---

<article class="mx-auto w-full max-w-2xl px-4 pt-32 pb-24 sm:px-6 sm:pt-40">
  {
    section && (
      <JsonLd data={contentPageData({ href, title: page.title, description: page.description, section, updated })} />
    )
  }
  {
    section ? (
      <a href={section.href} class="text-sm font-medium text-ds-accent hover:underline">
        {eyebrow}
      </a>
    ) : (
      <p class="text-sm font-medium text-ds-accent">{eyebrow}</p>
    )
  }
  <h1 class="mt-3 text-[30px] leading-[1.15] font-medium tracking-[-0.025em] text-balance sm:text-[36px]">
    {page.title}
  </h1>
  <p class="mt-3 text-base leading-relaxed text-pretty text-ds-muted">{page.description}</p>
  <Updated date={updated} />
  <Markdown body={page.body} />
</article>
{cta && <FinalCta />}
