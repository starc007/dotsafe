---
import Reveal from '@/components/landing/Reveal.astro';

/** A section's label, then its claim: a dark title and a grey continuation at
 * the same size, read as one sentence. The continuation is the slot. */
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<Reveal class="max-w-2xl">
  <p class="text-sm text-ds-muted">{eyebrow}</p>
  <h2 class="mt-3 text-[22px] leading-[1.3] font-medium tracking-[-0.005em] text-balance sm:text-2xl">
    {title} <span class="text-ds-muted"><slot /></span>
  </h2>
</Reveal>
