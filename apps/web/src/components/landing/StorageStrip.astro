---

<section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
  <Reveal>
    <p class="text-center text-sm text-ds-muted">Syncs through storage you already have</p>
    <ul class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
      {
        SERVICES.map((s) => (
          <li class="flex h-20 items-center justify-center gap-2 rounded-2xl border border-ds-line text-sm font-medium text-ds-muted">
            {s.path ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-current">
                <path d={s.path} />
              </svg>
            ) : (
              <Database aria-hidden className="size-5" />
            )}
            {s.name}
          </li>
        ))
      }
    </ul>
  </Reveal>
</section>
