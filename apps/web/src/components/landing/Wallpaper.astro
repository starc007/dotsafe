---
import { cn } from '@/lib/cn';
import { SCENE_FALLBACKS, type Scene } from '@/lib/scenes';
import { WallpaperPaint } from '@/components/landing/WallpaperPaint';

/** A framed, slowly moving painting for product shots and demos to sit on.
 * The frame and its content are plain HTML; only the paint is an island,
 * started as it nears the screen. */
interface Props {
  scene: Scene;
  class?: string;
}

const { scene, class: className } = Astro.props;
---

<div class={cn('relative isolate overflow-hidden rounded-2xl', className)} style={{ background: SCENE_FALLBACKS[scene] }}>
  <WallpaperPaint client:visible={{ rootMargin: '200px' }} scene={scene} />
  <slot />
</div>
