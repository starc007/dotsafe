---
import { FaqList } from '@/components/landing/FaqList';
import Reveal from '@/components/landing/Reveal.astro';
import SectionHeading from '@/components/landing/SectionHeading.astro';

/** Common questions, each opening in place. */
---

<section id="faq" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
  <div class="grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <SectionHeading eyebrow="FAQ" title="Questions, answered.">Anything else, ask on GitHub.</SectionHeading>
    </div>
    <Reveal class="md:col-span-3">
      <FaqList client:visible />
    </Reveal>
  </div>
</section>
