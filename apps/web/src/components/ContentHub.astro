---
import { ArrowUpRight } from 'lucide-react';
import type { Section } from '@/lib/content-pages';
import { BrandMark } from '@/components/BrandMark';
import FinalCta from '@/components/landing/FinalCta.astro';

/** A hub page: every page of a section as a card, grouped, linking each one
 * so none is an orphan. Cards show the short label and blurb from
 * lib/content-pages.ts; the full title and description are on the page. */
interface Props {
  section: Section;
}

const { section } = Astro.props;

/** "HashiCorp Vault" → "HV", "1Password" → "1P": a neutral mark instead of a
 * brand logo. */
function initials(label: string) {
  const words = label.split(/\s+/);
  return words.length > 1 ? words[0][0] + words[1][0] : (label.match(/^\d?[a-zA-Z]/)?.[0] ?? label[0]);
}
---

<section class="mx-auto w-full max-w-5xl px-4 pt-32 pb-24 sm:px-6 sm:pt-40">
  <h1 class="max-w-2xl text-[30px] leading-[1.15] font-medium tracking-[-0.025em] text-balance sm:text-[36px]">
    {section.title}
  </h1>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-pretty text-ds-muted">{section.description}</p>
  {
    section.groups.map((group) => (
      <div class="mt-12">
        <h2 class="text-sm font-medium text-ds-muted">{group.title}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {group.items.map((item) => (
            <li>
              <a
                href={`${section.href}/${item.slug}`}
                class="group relative flex h-full flex-col gap-4 rounded-2xl border border-ds-line p-4 transition-colors duration-200 hover:border-ds-fg/20 focus-visible:border-ds-fg/30 focus-visible:outline-none"
              >
                <div class="flex items-center gap-3">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-ds-shell text-ds-fg/85">
                    {item.logo ? (
                      <BrandMark name={item.logo} />
                    ) : (
                      <span class="text-xs font-semibold tracking-tight uppercase">{initials(item.label)}</span>
                    )}
                  </span>
                  <span class="min-w-0 truncate text-[15px] font-medium">{item.label}</span>
                  <ArrowUpRight
                    aria-hidden
                    className="ml-auto size-4 shrink-0 -translate-x-1 translate-y-1 text-ds-muted opacity-0 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 motion-reduce:transition-none"
                  />
                </div>
                <p class="line-clamp-2 text-sm leading-snug text-pretty text-ds-muted">{item.blurb}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
<FinalCta />
