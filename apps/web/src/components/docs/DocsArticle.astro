---
import { docsEntry } from '@/lib/docs';
import { docsContent } from '@/lib/docs-content';
import { docsData } from '@/lib/structured-data';
import { JsonLd } from '@/components/landing/JsonLd';
import Markdown from '@/components/docs/Markdown.astro';
import Updated from '@/components/Updated.astro';
import { pageUpdated } from '@/lib/updated';
import { DocsMobileNav } from '@/components/docs/DocsMobileNav';
import { DocsPageActions } from '@/components/docs/DocsPageActions';
import { DocsPager } from '@/components/docs/DocsPager';
import { DocsSidebar } from '@/components/docs/DocsSidebar';
import { DocsToc } from '@/components/docs/DocsToc';

/** A docs page, rendered from `public/<href>.md`: the page list pinned on the
 * left, then its section and title, the Copy page menu, the body, links to the
 * pages around it, and "On this page" beside it on wide screens. The slot goes
 * after the body. */
interface Props {
  href: string;
}

const { href } = Astro.props;
const entry = docsEntry(href);
const page = docsContent(href);
const updated = pageUpdated(href);
---

<div class="mx-auto grid max-w-6xl gap-8 px-4 pt-24 pb-24 sm:px-6 sm:pt-28 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-14 lg:pt-32">
  <aside class="hidden lg:block">
    <DocsSidebar href={href} className="sticky top-28 -ml-3 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8" />
  </aside>
  <DocsMobileNav client:media="(max-width: 1023px)" href={href} />
  <div class="min-w-0">
    <div class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_11rem]">
      <JsonLd data={docsData({ href, title: page.title, description: page.description, updated })} />
      <article class="max-w-2xl min-w-0">
        <div class="flex items-center justify-between gap-4">
          <p class="text-sm font-medium text-ds-accent">{entry.group}</p>
          <DocsPageActions client:idle href={href} markdown={page.markdown} />
        </div>
        <h1 class="mt-3 text-[30px] leading-[1.15] font-medium tracking-[-0.025em] text-balance sm:text-[36px]">
          {page.title}
        </h1>
        <p class="mt-3 text-base leading-relaxed text-pretty text-ds-muted">{page.description}</p>
        <Updated date={updated} />
        <Markdown body={page.body} />
        <slot />
        <DocsPager href={href} />
      </article>
      <aside class="hidden xl:block">
        <div class="sticky top-28">
          <DocsToc client:media="(min-width: 1280px)" headings={page.headings} />
        </div>
      </aside>
    </div>
  </div>
</div>
