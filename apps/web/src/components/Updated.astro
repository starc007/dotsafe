---
import { formatUpdated } from '@/lib/updated';

/** The date line under a page's description. `date` is when it last changed
 * and `published` when a blog post first went up, both `YYYY-MM-DD`. A post
 * shows its published date, and "Updated" only once it changed after that
 * day; other pages show "Updated". Without dates, nothing is shown. */
interface Props {
  date?: string;
  published?: string;
}

const { date, published } = Astro.props;
const changed = published ? (date && date > published ? date : undefined) : date;
---

{
  (published || changed) && (
    <p class="mt-3 text-sm text-ds-muted">
      {published && <time datetime={published}>{formatUpdated(published)}</time>}
      {published && changed && <span aria-hidden> · </span>}
      {changed && (
        <>
          Updated <time datetime={changed}>{formatUpdated(changed)}</time>
        </>
      )}
    </p>
  )
}
