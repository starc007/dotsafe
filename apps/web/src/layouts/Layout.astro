---
import '@/styles/global.css';
import interMedium from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import type { PageMeta } from '@/lib/seo';
import Head from '@/components/Head.astro';
import Nav from '@/components/landing/Nav.astro';
import Footer from '@/components/landing/Footer.astro';

interface Props {
  meta: PageMeta;
}

const { meta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head meta={meta} />
    <!-- Headings are Inter Medium. Fetched with the page rather than after the
         CSS, so the first paint already uses it and nothing re-wraps. -->
    <link rel="preload" href={interMedium} as="font" type="font/woff2" crossorigin />

    <!-- Scroll-in reveals hide content only once scripts can show it again. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav />
    <main class="flex-1"><slot /></main>
    <Footer />
    <script>
      import '@/scripts/reveal';
      import '@/scripts/analytics';
    </script>
  </body>
</html>
