{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The site is a static export (`next build` writes `out/`), served as static
  // assets by a Worker with no code of its own.
  "name": "dotsafe-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "dotsafe.dev", "custom_domain": true }]
}
