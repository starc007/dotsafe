{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dotsafe",
  "version": "0.1.0",
  "identifier": "app.dotsafe",
  "mainBinaryName": "dotsafe-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dotsafe",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QUI3QTFBMjI4RDhGQTUKUldTbGo0MGlHbnFybFZ4RlpxWHpMZ25iZUk5TDU2QUhocmNhNXNEVU82OG9IbnF4a2lrc243dzIK",
      "endpoints": ["https://github.com/starc007/dotsafe/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
